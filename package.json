{
  "name": "hista-ui",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "packageManager": "pnpm@10.22.0",
  "scripts": {
    "start": "vite --open",
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint . ",
    "lint:fix": "eslint . --fix",
    "lint:debug": "pnpm dlx eslint --debug eslint.config.mjs",
    "test": "vitest",
    "test:nowatch": "vitest run",
    "tsc": "tsc",
    "knip": "knip",
    "prepare": "husky",
    "install:local-package": "pnpm install ../auth-module/bbrighter-auth-module-0.1.1.tgz --no-cache",
    "dependencies:ci": "npx depcruise src  --include-only \"^src\"",
    "dependencies:table": "npx depcruise src  --include-only \"^src\" --output-type html > graph.html",
    "dependencies:graph": "npx depcruise --include-only \"^src\" --output-type dot src | dot -T svg > graph.svg"
  },
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=10.0.0"
  },
  "dependencies": {
    "@bbrighter/auth-module": "~1.3.0",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/icons-material": "^7.3.7",
    "@mui/material": "^7.3.7",
    "@mui/x-charts": "^8.27.0",
    "@mui/x-data-grid": "^8.27.0",
    "@mui/x-date-pickers": "^8.27.0",
    "dayjs": "^1.11.19",
    "immer": "^11.1.3",
    "lodash.debounce": "^4.0.8",
    "mitt": "^3.0.1",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-error-boundary": "^6.1.0",
    "react-router-dom": "^7.13.0",
    "vite-plugin-svgr": "^4.5.0",
    "vitest-localstorage-mock": "^0.1.2",
    "xlsx": "^0.18.5",
    "zustand": "^5.0.11"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@stylistic/eslint-plugin": "^5.7.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/lodash.debounce": "^4.0.9",
    "@types/node": "^25.2.1",
    "@types/react": "^19.2.13",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.3",
    "@vitest/coverage-v8": "^4.0.18",
    "dependency-cruiser": "^17.3.7",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-compiler": "19.1.0-rc.2",
    "eslint-plugin-simple-import-sort": "^12.1.1",
    "globals": "^17.3.0",
    "husky": "^9.1.7",
    "jsdom": "^28.0.0",
    "knip": "^5.83.1",
    "msw": "^2.12.9",
    "rollup-plugin-visualizer": "^6.0.5",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.54.0",
    "vite": "^7.3.1",
    "vitest": "^4.0.18"
  }
}