{
	"name": "hista-ui",
	"private": true,
	"version": "1.0.0",
	"type": "module",
	"packageManager": "pnpm@10.22.0",
	"scripts": {
		"start": "vite --open",
		"dev": "vite",
		"build": "vite build",
		"lint:local": "biome check --reporter=concise",
		"lint:fix": "biome check --write",
		"lint": "biome ci",
		"test": "vitest",
		"test:debug": "DEBUG=true vitest",
		"test:nowatch": "vitest run",
		"typecheck": "tsc",
		"knip": "knip",
		"prepare": "husky",
		"install:local-package": "pnpm install ../auth-module/bbrighter-auth-module-0.1.1.tgz --no-cache",
		"dependencies:ci": "npx depcruise src  --include-only \"^src\"",
		"dependencies:table": "npx depcruise src  --include-only \"^src\" --output-type html > graph.html",
		"dependencies:graph": "npx depcruise --include-only \"^src\" --output-type dot src | dot -T svg > graph.svg",
		"validate": "knip & tsc & pnpm dependencies:ci & pnpm lint"
	},
	"engines": {
		"node": "24.x",
		"pnpm": ">=10.0.0"
	},
	"dependencies": {
		"@atlaskit/pragmatic-drag-and-drop": "^1.8.1",
		"@base-ui/react": "^1.6.0",
		"@bbrighter/auth-module": "^2.3.0",
		"@emotion/react": "^11.14.0",
		"@emotion/styled": "^11.14.1",
		"@mui/icons-material": "^9.2.0",
		"@mui/material": "^9.2.0",
		"@mui/x-charts": "^9.9.0",
		"@mui/x-data-grid": "^9.9.0",
		"@mui/x-date-pickers": "^9.9.0",
		"dayjs": "^1.11.21",
		"immer": "^11.1.11",
		"lodash.debounce": "^4.0.8",
		"mitt": "^3.0.1",
		"react": "^19.2.7",
		"react-dom": "^19.2.7",
		"react-error-boundary": "^6.1.2",
		"react-router-dom": "^7.18.1",
		"react-swipeable-list": "^1.10.0",
		"vite-plugin-svgr": "^5.2.0",
		"vitest-localstorage-mock": "^0.1.2",
		"xlsx": "^0.18.5",
		"zustand": "^5.0.14"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.4",
		"@testing-library/jest-dom": "^6.9.1",
		"@testing-library/react": "^16.3.2",
		"@testing-library/user-event": "^14.6.1",
		"@types/lodash.debounce": "^4.0.9",
		"@types/node": "^25.9.5",
		"@types/react": "^19.2.17",
		"@types/react-dom": "^19.2.3",
		"@vitejs/plugin-react": "^6.0.3",
		"@vitest/coverage-v8": "^4.1.10",
		"dependency-cruiser": "^18.1.0",
		"happy-dom": "^20.10.6",
		"husky": "^9.1.7",
		"knip": "^6.27.0",
		"msw": "^2.15.0",
		"rollup-plugin-visualizer": "^7.0.1",
		"typescript": "^6.0.3",
		"vite": "^8.1.5",
		"vite-plugin-checker": "^0.14.4",
		"vitest": "^4.1.10"
	}
}
