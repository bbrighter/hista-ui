{
	"name": "hista-ui",
	"private": true,
	"version": "1.0.0",
	"type": "module",
	"//packageManagerComment": "remove once Vercel supports devEngines.packageManager",
	"packageManager": "pnpm@11.21.0",
	"scripts": {
		"start": "vite --open",
		"dev": "vite",
		"build": "vite build",
		"lint:local": "biome check --reporter=concise",
		"lint:fix": "biome check --write",
		"lint": "biome ci",
		"test": "vitest",
		"test:debug": "DEBUG=true vitest",
		"test:ci": "vitest run --coverage",
		"typecheck": "tsc",
		"knip": "knip",
		"prepare": "husky",
		"install:local-package": "pnpm install ../auth-module/bbrighter-auth-module-0.1.1.tgz --no-cache",
		"dependencies:ci": "pnpm exec depcruise src  --include-only \"^src\"",
		"dependencies:table": "pnpm exec depcruise src  --include-only \"^src\" --output-type html > graph.html",
		"dependencies:graph": "pnpm exec depcruise --include-only \"^src\" --output-type dot src | dot -T svg > graph.svg",
		"validate": "knip & tsc & pnpm dependencies:ci & pnpm lint"
	},
	"devEngines": {
		"packageManager": {
			"name": "pnpm",
			"version": "11.21.0",
			"onFail": "error"
		},
		"runtime": {
			"name": "node",
			"version": "24",
			"onFail": "error"
		}
	},
	"dependencies": {
		"@atlaskit/pragmatic-drag-and-drop": "^2.0.2",
		"@base-ui/react": "^1.7.0",
		"@bbrighter/auth-module": "^2.3.0",
		"@emotion/react": "^11.14.0",
		"@emotion/styled": "^11.14.1",
		"@mui/icons-material": "^9.3.1",
		"@mui/material": "^9.3.1",
		"@mui/x-charts": "^9.11.1",
		"@mui/x-data-grid": "^9.11.0",
		"@mui/x-date-pickers": "^9.11.0",
		"dayjs": "^1.11.21",
		"immer": "^11.1.16",
		"lodash.debounce": "^4.0.8",
		"mitt": "^3.0.1",
		"react": "^19.2.8",
		"react-dom": "^19.2.8",
		"react-error-boundary": "^6.1.2",
		"react-router-dom": "^7.18.2",
		"react-swipeable-list": "^1.10.0",
		"vite-plugin-svgr": "^5.2.0",
		"vitest-localstorage-mock": "^0.1.2",
		"xlsx": "^0.18.5",
		"zustand": "^5.0.14"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.7",
		"@testing-library/jest-dom": "^7.0.0",
		"@testing-library/react": "^16.3.2",
		"@testing-library/user-event": "^14.6.3",
		"@types/lodash.debounce": "^4.0.9",
		"@types/node": "^26.2.0",
		"@types/react": "^19.2.18",
		"@types/react-dom": "^19.2.4",
		"@vitejs/plugin-react": "^6.0.5",
		"@vitest/coverage-v8": "^4.1.10",
		"dependency-cruiser": "^18.1.1",
		"happy-dom": "^20.11.2",
		"husky": "^9.1.7",
		"knip": "^6.32.0",
		"msw": "^2.15.0",
		"rollup-plugin-visualizer": "^7.0.1",
		"source-map": "^0.7.6",
		"@typescript/native": "npm:typescript@^7.0.2",
		"typescript": "npm:@typescript/typescript6@^6.0.2",
		"vite": "^8.2.1",
		"vite-plugin-checker": "^0.14.5",
		"vitest": "^4.1.10"
	}
}
