{
  "name": "hista-ui",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "packageManager": "pnpm@10.22.0",
  "scripts": {
    "start": "vite --open",
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint . ",
    "lint:fix": "eslint . --fix",
    "lint:debug": "pnpm dlx eslint --debug eslint.config.mjs",
    "test": "vitest",
    "test:debug": "DEBUG=true vitest",
    "test:nowatch": "vitest run",
    "tsc": "tsc",
    "knip": "knip",
    "prepare": "husky",
    "install:local-package": "pnpm install ../auth-module/bbrighter-auth-module-0.1.1.tgz --no-cache",
    "dependencies:ci": "npx depcruise src  --include-only \"^src\"",
    "dependencies:table": "npx depcruise src  --include-only \"^src\" --output-type html > graph.html",
    "dependencies:graph": "npx depcruise --include-only \"^src\" --output-type dot src | dot -T svg > graph.svg",
    "validate": "knip & tsc & pnpm dependencies:ci & pnpm lint"
  },
  "engines": {
    "node": "24.x",
    "pnpm": ">=10.0.0"
  },
  "dependencies": {
    "@atlaskit/pragmatic-drag-and-drop": "^1.8.1",
    "@base-ui/react": "^1.4.1",
    "@bbrighter/auth-module": "^2.2.0",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/icons-material": "^9.0.0",
    "@mui/material": "^9.0.0",
    "@mui/x-charts": "^9.0.4",
    "@mui/x-data-grid": "^9.0.4",
    "@mui/x-date-pickers": "^9.0.4",
    "dayjs": "^1.11.20",
    "immer": "^11.1.4",
    "lodash.debounce": "^4.0.8",
    "mitt": "^3.0.1",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "react-error-boundary": "^6.1.1",
    "react-router-dom": "^7.14.2",
    "react-swipeable-list": "^1.10.0",
    "vite-plugin-svgr": "^5.2.0",
    "vitest-localstorage-mock": "^0.1.2",
    "xlsx": "^0.18.5",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@eslint-react/eslint-plugin": "^2.13.0",
    "@eslint/js": "^9.39.4",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/lodash.debounce": "^4.0.9",
    "@types/node": "^25.6.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "@vitest/coverage-v8": "^4.1.5",
    "dependency-cruiser": "^17.3.10",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-compiler": "19.1.0-rc.2",
    "eslint-plugin-simple-import-sort": "^13.0.0",
    "globals": "^17.5.0",
    "happy-dom": "^20.9.0",
    "husky": "^9.1.7",
    "jsdom": "^29.1.0",
    "knip": "^6.9.0",
    "msw": "^2.14.2",
    "prettier": "^3.8.3",
    "rollup-plugin-visualizer": "^7.0.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.59.1",
    "vite": "^8.0.10",
    "vitest": "^4.1.5"
  }
}