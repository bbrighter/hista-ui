{
  "name": "hista-ui",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "start": "vite --open",
    "dev": "vite",
    "build": "tsc && vite build",
    "lint": "eslint . && tsc",
    "lint:fix": "eslint . --fix && tsc",
    "test": "vitest",
    "test:nowatch": "vitest run",
    "tsc": "tsc",
    "knip": "knip",
    "prepare": "husky",
    "dependencies:ci": "npx depcruise src  --include-only \"^src\" --output-type html > graph.html",
    "dependencies:show": "npx depcruise --include-only \"^src\" --output-type dot src | dot -T svg > graph.svg"
  },
  "engines": {
    "node": ">=22.0.0",
    "npm": ">=11.0.0"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/icons-material": "^7.3.4",
    "@mui/material": "^7.3.4",
    "@mui/x-data-grid": "^8.13.1",
    "@mui/x-date-pickers": "^8.12.0",
    "dayjs": "^1.11.18",
    "exceljs": "^4.4.0",
    "immer": "^10.1.3",
    "lodash.debounce": "^4.0.8",
    "mitt": "^3.0.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-error-boundary": "^6.0.0",
    "react-router-dom": "^7.9.3",
    "vite-plugin-svgr": "^4.5.0",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@eslint/js": "^9.10.0",
    "@stylistic/eslint-plugin": "^5.4.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/lodash.debounce": "^4.0.9",
    "@types/node": "^24.6.2",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.4",
    "@vitest/coverage-v8": "^3.2.4",
    "dependency-cruiser": "^17.0.2",
    "eslint": "^9.37.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-compiler": "^19.1.0-rc.2",
    "eslint-plugin-simple-import-sort": "^12.1.1",
    "globals": "^16.4.0",
    "husky": "^9.1.7",
    "jsdom": "^26.1.0",
    "knip": "^5.64.1",
    "msw": "^2.11.3",
    "rollup-plugin-visualizer": "^6.0.4",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.45.0",
    "vite": "^7.1.9",
    "vitest": "^3.2.4"
  }
}
