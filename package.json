{
	"name": "hista-ui",
	"private": true,
	"version": "1.0.0",
	"type": "module",
	"//packageManagerComment": "remove once Vercel supports devEngines.packageManager",
	"packageManager": "pnpm@11.21.0",
	"scripts": {
		"start": "vite --open",
		"dev": "vite",
		"build": "pnpm l10n:compile && vite build",
		"lint:local": "biome check --reporter=concise",
		"lint:fix": "biome check --write",
		"lint": "biome ci",
		"test": "vitest",
		"test:debug": "DEBUG=true vitest",
		"test:ci": "vitest run",
		"typecheck": "tsc",
		"knip": "knip",
		"prepare": "husky",
		"install:local-package": "pnpm install ../auth-module/bbrighter-auth-module-0.1.1.tgz --no-cache",
		"dependencies:ci": "pnpm exec depcruise src  --include-only \"^src\"",
		"dependencies:table": "pnpm exec depcruise src  --include-only \"^src\" --output-type html > graph.html",
		"dependencies:graph": "pnpm exec depcruise --include-only \"^src\" --output-type dot src | dot -T svg > graph.svg",
		"validate": "knip & tsc & pnpm dependencies:ci & pnpm lint",
		"l10n:extract": "lingui extract --clean --overwrite",
		"l10n:compile": "lingui compile --typescript"
	},
	"devEngines": {
		"packageManager": {
			"name": "pnpm",
			"version": "11.21.0",
			"onFail": "error"
		},
		"runtime": {
			"name": "node",
			"version": "24",
			"onFail": "error"
		}
	},
	"dependencies": {
		"@atlaskit/pragmatic-drag-and-drop": "^2.0.2",
		"@base-ui/react": "^1.8.0",
		"@bbrighter/auth-module": "file:../auth-module/bbrighter-auth-module-0.1.1.tgz",
		"@emotion/react": "^11.14.0",
		"@emotion/styled": "^11.14.1",
		"@lingui/react": "^6.9.0",
		"@mui/icons-material": "^9.4.0",
		"@mui/material": "^9.4.0",
		"@mui/x-charts": "^9.13.0",
		"@mui/x-data-grid": "^9.13.0",
		"@mui/x-date-pickers": "^9.13.0",
		"dayjs": "^1.11.23",
		"immer": "^11.1.18",
		"lodash.debounce": "^4.0.8",
		"mitt": "^3.0.1",
		"react": "^19.3.0",
		"react-dom": "^19.3.0",
		"react-error-boundary": "^6.1.5",
		"react-router-dom": "^7.18.4",
		"react-swipeable-list": "^1.10.0",
		"vite-plugin-svgr": "^5.2.0",
		"xlsx": "^0.18.5",
		"zustand": "^5.0.15"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.14",
		"@lingui/cli": "^6.9.0",
		"@lingui/core": "^6.9.0",
		"@lingui/format-po": "^6.9.0",
		"@lingui/vite-plugin": "^6.9.0",
		"@testing-library/jest-dom": "^7.0.1",
		"@testing-library/react": "^16.3.3",
		"@testing-library/user-event": "^14.6.7",
		"@types/lodash.debounce": "^4.0.9",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"@typescript/native": "npm:typescript@^7.0.2",
		"@vitejs/plugin-react": "^6.1.1",
		"@vitest/coverage-v8": "^5.0.1",
		"dependency-cruiser": "^18.3.1",
		"happy-dom": "^20.14.5",
		"husky": "^9.1.7",
		"knip": "^6.35.1",
		"msw": "^2.15.0",
		"rollup-plugin-visualizer": "^7.1.1",
		"source-map": "^0.8.0",
		"typescript": "npm:@typescript/typescript6@^6.0.2",
		"vite": "^8.3.0",
		"vite-plugin-checker": "^0.14.5",
		"vitest": "^5.0.1"
	}
}
